      }
    },
    {
      "namespace": "client",
      "operation_name": "client_records_export",
      "model_name": "RecordExport",
      "request_method": [
        "POST"
      ],
      "api_url": "/client/records/export",
      "exec_method": {
        "module_name": "client.endpoints",
        "method_name": "records_export"
      }
    },
    {
      "namespace": "client",
