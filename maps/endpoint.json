      ],
      "api_url": "/workers/<string:worker>/run",
      "exec_method": {
        "module_name": "api.worker_endpoints",
        "method_name": "worker_run"
      }
    },
    {
      "namespace": "client",
      "operation_name": "client_records",
      "model_name": "Empty",
