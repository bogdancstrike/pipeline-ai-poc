{
  "namespaces": [
    {
      "name": "pipeline",
      "description": "Submit one video path and let the 7-worker pipeline run over Kafka"
    },
    {
      "name": "workers",
      "description": "Run ONE worker synchronously — the answer is the HTTP response, nothing is published to Kafka"
    },
    {
      "name": "client",
      "description": "The client app: search the analysed records, chart them, and export them"
    }
  ],
  "models": {
    "Empty": {},
    "AnalyzeVideo": {
      "path": {
        "type": "string",
        "args": {
          "required": true,
          "description": "Path to the video, as the AI services (172.17.12.80:8821-8825) will open it. Forwarded untouched; resolved locally first when the same file is mounted here (VIDEO_SEARCH_DIRS: videos/, data/).",
          "example": "/video/migrants.mp4"
        }
      },
      "id": {
        "type": "string",
        "args": {
          "required": false,
          "description": "Message id. Both aggregators (W6, W7) regroup their branches by it, so it must be unique per submission. Generated when omitted.",
          "example": "vid-demo-1"
        }
      },
      "name": {
        "type": "string",
        "args": {
          "required": false,
          "description": "Name W7 writes the record under: '<name without extension>_analysis.json' in OUTPUT_DIR. Defaults to the video file name.",
          "example": "migrants.mp4"
        }
      },
      "options": {
        "type": "dict",
        "args": {
          "required": false,
          "description": "Per-submit overrides for the transcribe service (:8824). Recognised keys: language, task, format, transcription_level, dialog_timestamps. Anything else is ignored; omitted keys fall back to .env.",
          "example": {
            "language": "ar",
            "task": "translate"
          }
        }
      }
    },
    "RunWorker": {
      "path": {
        "type": "string",
        "args": {
          "required": false,
          "description": "The video to run the worker on. Required unless you supply 'message' instead.",
          "example": "/video/migrants.mp4"
        }
      },
      "id": {
        "type": "string",
        "args": {
          "required": false,
          "description": "Name for this run — it labels every log line. Generated when omitted.",
          "example": "try-ocr-1"
        }
      },
      "name": {
        "type": "string",
        "args": {
          "required": false,
          "description": "Video name, as the pipeline would carry it. Defaults to the file name in 'path'.",
          "example": "migrants.mp4"
        }
      },
      "options": {
        "type": "dict",
        "args": {
          "required": false,
          "description": "Overrides for the transcribe service (:8824): language, task, format, transcription_level, dialog_timestamps.",
          "example": {
            "language": "ar",
            "task": "translate"
          }
        }
      },
      "chain": {
        "type": "boolean",
        "args": {
          "required": false,
          "description": "true (default): run the upstream workers first, so this worker receives the message its own topic would have carried — calling 'aggregator' therefore runs the whole pipeline synchronously. false: feed it 'message' (or the body itself) untouched.",
          "example": true
        }
      },
      "persist": {
        "type": "boolean",
        "args": {
          "required": false,
          "description": "false (default): the final aggregator prints its record but does not write output/<video>_analysis.json, so a trial run overwrites nothing. true: write it, as the pipeline does.",
          "example": false
        }
      },
      "message": {
        "type": "dict",
        "args": {
          "required": false,
          "description": "Feed the worker this exact message instead of building one — the shape its topic carries. Implies chain=false. Use it to drive an aggregator with branches you assembled yourself.",
          "example": {
            "path": "/video/migrants.mp4",
            "name": "migrants.mp4"
          }
        }
      }
    },
    "RecordSearch": {
      "filters": {
        "type": "dict",
        "args": {
          "required": false,
          "description": "Field filters, e.g. {\"sentiment\": \"NEGATIVE\", \"person_count__gt\": 0}. Any declared field, with an optional __operator suffix (eq, ne, contains, not, starts, ends, gt, gte, lt, lte, between, before, after, in, not_in, empty, not_empty).",
          "example": {
            "sentiment": "NEGATIVE",
            "analysed_at_from": "2026-09-01"
          }
        }
      },
      "query_text": {
        "type": "string",
        "args": {
          "required": false,
          "description": "Free text, swept across every searchable field (summary, entities, transcript, description, OCR, name).",
          "example": "ceuta"
        }
      },
      "condition_tree": {
        "type": "dict",
        "args": {
          "required": false,
          "description": "The advanced query builder's nested AND/OR tree, compiled to SQL by client/rules.py.",
          "example": {
            "type": "group",
            "conjunction": "AND",
            "children1": {
              "a1": {
                "type": "rule",
                "properties": {
                  "field": "sentiment",
                  "operator": "select_equals",
                  "value": [
                    "NEGATIVE"
                  ]
                }
              }
            }
          }
        }
      },
      "columns": {
        "type": "list",
        "args": {
          "required": false,
          "description": "Which declared fields the rows carry. Defaults to the explorer's own column set.",
          "example": [
            "name",
            "analysed_at",
            "sentiment",
            "entity_count"
          ]
        },
        "super": "string"
      },
      "facets": {
        "type": "boolean",
        "args": {
          "required": false,
          "description": "Also return a GROUP BY count per faceted field, for the filter menus.",
          "example": true
        }
      },
      "page": {
        "type": "integer",
        "args": {
          "required": false,
          "description": "1-based page number.",
          "example": 1
        }
      },
      "page_size": {
        "type": "integer",
        "args": {
          "required": false,
          "description": "Rows per page, 1-200.",
          "example": 25
        }
      },
      "sort": {
        "type": "string",
        "args": {
          "required": false,
          "description": "Any sortable field.",
          "example": "analysed_at"
        }
      },
      "order": {
        "type": "string",
        "args": {
          "required": false,
          "description": "asc | desc",
          "example": "desc"
        }
      }
    },
    "RecordExport": {
      "format": {
        "type": "string",
        "args": {
          "required": false,
          "description": "csv | json | xlsx",
          "example": "csv"
        }
      },
      "filters": {
        "type": "dict",
        "args": {
          "required": false,
          "description": "As /client/records/search."
        }
      },
      "query_text": {
        "type": "string",
        "args": {
          "required": false,
          "description": "As /client/records/search."
        }
      },
      "condition_tree": {
        "type": "dict",
        "args": {
          "required": false,
          "description": "As /client/records/search."
        }
      },
      "columns": {
        "type": "list",
        "args": {
          "required": false,
          "description": "Columns the file carries."
        },
        "super": "string"
      },
      "sort": {
        "type": "string",
        "args": {
          "required": false,
          "description": "Any sortable field."
        }
      },
      "order": {
        "type": "string",
        "args": {
          "required": false,
          "description": "asc | desc"
        }
      }
    },
    "SavedSearch": {
      "name": {
        "type": "string",
        "args": {
          "required": true,
          "description": "What this question is called.",
          "example": "Negative, with people"
        }
      },
      "description": {
        "type": "string",
        "args": {
          "required": false,
          "description": "Why it is worth keeping."
        }
      },
      "owner": {
        "type": "string",
        "args": {
          "required": false,
          "description": "Who saved it. A label, not a principal — the app has no auth yet.",
          "example": "ana"
        }
      },
      "pinned": {
        "type": "boolean",
        "args": {
          "required": false,
          "description": "Show it first.",
          "example": false
        }
      },
      "payload": {
        "type": "dict",
        "args": {
          "required": false,
          "description": "The explorer request to store: filters, query_text, condition_tree, columns, sort, order, page_size."
        }
      }
    },
    "SavedSearchUpdate": {
      "name": {
        "type": "string",
        "args": {
          "required": false,
          "description": "What this question is called. Omit to leave it unchanged.",
          "example": "Negative, with people"
        }
      },
      "description": {
        "type": "string",
        "args": {
          "required": false,
          "description": "Why it is worth keeping."
        }
      },
      "owner": {
        "type": "string",
        "args": {
          "required": false,
          "description": "Who saved it. A label, not a principal — the app has no auth yet.",
          "example": "ana"
        }
      },
      "pinned": {
        "type": "boolean",
        "args": {
          "required": false,
          "description": "Show it first.",
          "example": false
        }
      },
      "payload": {
        "type": "dict",
        "args": {
          "required": false,
          "description": "The explorer request to store: filters, query_text, condition_tree, columns, sort, order, page_size."
        }
      }
    }
  },
  "endpoints": [
    {
      "namespace": "pipeline",
      "operation_name": "analyze",
      "model_name": "AnalyzeVideo",
      "request_method": [
        "POST"
      ],
      "api_url": "/pipeline/analyze",
      "exec_method": {
        "module_name": "api.pipeline_endpoints",
        "method_name": "pipeline_analyze"
      }
    },
    {
      "namespace": "pipeline",
      "operation_name": "health",
