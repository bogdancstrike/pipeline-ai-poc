# ============================================================
# Video analysis pipeline — environment configuration
# All values have sane localhost defaults.
# ============================================================

# ---- Host ports (docker-compose) ----
# Only the HOST side of each mapping. Change one here if something else on the
# machine already owns that port — nothing inside the containers moves, so no
# other setting needs to follow. After editing: docker compose up -d
PORT_API=5696
PORT_FRONTEND=5697
PORT_KAFKA=9094
PORT_KAFKA_UI=8083
PORT_REDIS=6379
PORT_REDIS_INSIGHT=5540
PORT_POSTGRES=5434
PORT_PGADMIN=5050

# ---- Kafka ----
# Host-side address, used when you run the app outside Docker. Must match
# PORT_KAFKA above. Inside compose this is overridden to kafka:9092.
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
WORKER_NAME=video-pipeline
ERROR_TOPIC=video.dlq
# OCR and transcript branch messages are well above Kafka's 1 MB default —
# the broker is configured to match (message.max.bytes in docker-compose.yml).
KAFKA_MAX_MESSAGE_BYTES=20971520

# ---- Redis (framework aggregator buffers — W6 and W7) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# How long a half-analysed video may wait in Redis for its other branches.
# Transcribing a long video can take minutes — keep this generous.
AGGREGATOR_TIMEOUT_SEC=3600

# ============================================================
# AI services
# These are NOT part of docker-compose — they run on their own host.
# Only the QF pipeline (app + kafka + redis) is containerised here.
# ============================================================
AI_FACE_MATCH_URL=http://172.17.12.80:8821
AI_DESCRIBE_URL=http://172.17.12.80:8822
AI_OCR_URL=http://172.17.12.80:8823
AI_TRANSCRIBE_URL=http://172.17.12.80:8824
AI_SUMMARIZE_URL=http://172.17.12.80:8825

# A cold model plus a long video easily runs into minutes.
AI_TIMEOUT_SEC=600
# Transport-level retries only (connection reset / 5xx). A 4xx fails at once.
AI_RETRIES=2
AI_RETRY_BACKOFF_SEC=2.0

# False (default) = a failing service is recorded on its branch and the pipeline
#                   still completes, so W7 writes a record naming what broke.
#                   A 4-way fan-in is only as available as its slowest branch.
# True            = re-raise, and let the framework retry/DLQ policy own it.
AI_FAIL_FAST=False

# Log the request and response body of every AI call (truncated).
AI_LOG_BODIES=True
AI_LOG_BODY_CHARS=400
# With LOGGING_LEVEL=DEBUG each call also logs its COMPLETE request and response
# body — the whole prompt, the whole transcript, every OCR frame. 0 = uncut.
AI_LOG_DEBUG_BODY_CHARS=0

# ---- Per-worker mock switches ----
# True  = the worker returns the canned answer from src/mock/mock_responses.py
#         and never opens a socket.
# False = the worker calls the real service above.
# Same topics, same message shapes, same code path either way — so a fully
# mocked run exercises the whole pipeline with no access to 172.17.12.80.
#
# NOTE: the five services do NOT share a filesystem — each resolves `path` on
# its own mount (/video/1.mp4 exists only for :8821, /video/sna.mp4 only for
# :8823). Until they are given a common mount, a live run needs a path all four
# extraction services can open. Mocked is the default for that reason.
MOCK_WORKER_FACE_MATCH=False
MOCK_WORKER_DESCRIBE=False
MOCK_WORKER_OCR=False
MOCK_WORKER_TRANSCRIBE=False
MOCK_WORKER_SUMMARY=False
MOCK_WORKER_ENTITIES=False
MOCK_WORKER_SENTIMENT=False

# Fake per-call latency in ms for a mocked worker (0 = instant).
MOCK_LATENCY_MS=50

# ---- transcribe (:8824) request body ----
TRANSCRIBE_LANGUAGE=ar
TRANSCRIBE_TASK=translate
TRANSCRIBE_FORMAT=dialog
TRANSCRIBE_LEVEL=word
TRANSCRIBE_DIALOG_TIMESTAMPS=False

# ---- video-ocr (:8823) ----
# Keep the per-frame array in the message. Off by default: nothing downstream
# reads it, and it is the bulkiest thing in the pipeline.
OCR_KEEP_FRAMES=False

# ---- summarize (:8825) ----
# W6 posts the same `inputs` three times, once per prompt file. The service
# takes the prompt TEXT in the body (`prompt_text`), so these name files under
# PROMPTS_DIR that the app reads and sends — edit the .txt, restart, done.
# PROMPTS_DIR=/app/src/prompts
SUMMARY_PROMPT=summary.txt
ENTITIES_PROMPT=entities.txt
SENTIMENT_PROMPT=sentiment.txt
SUMMARIZE_NUM_PREDICT=2048

# The two keys of the `inputs` dict. What is visible goes into ONE string under
# SUMMARIZE_KEY_DESCRIPTION, as titled sections:
#
#     VIDEO DESCRIPTION
#     ...
#
#     ON SCREEN TEXT
#     ...
#
# The identified persons are NOT here: face matching (W2) publishes straight to
# the final aggregator, so it never reaches the summary prompts.
SUMMARIZE_KEY_DESCRIPTION=video_description
SUMMARIZE_KEY_TRANSCRIPT=transcription
SECTION_DESCRIPTION=VIDEO DESCRIPTION
SECTION_OCR=ON SCREEN TEXT
# Shown under a heading whose worker returned nothing. Leave empty to drop the
# whole section instead.
SECTION_EMPTY_PLACEHOLDER=(none)

# ---- Video input ----
# Where to look for a submitted video when it is also mounted here. The AI
# services resolve the path on their own filesystem, so this is only a
# convenience check at submit time.
#VIDEO_SEARCH_DIRS=/app/videos:/app/data
# true  = forward a path we cannot see to the AI services anyway (default)
# false = reject it with a 400
VIDEO_PATH_PASSTHROUGH=True

# ---- Console output (W7) ----
# block | line | json
OUTPUT_FORMAT=block
OUTPUT_TEXT_PREVIEW_CHARS=400

# ---- File output (W7) ----
# <OUTPUT_DIR>/<video name without extension><OUTPUT_FILE_SUFFIX>
#   /video/migrants.mp4  ->  output/migrants_analysis.json
OUTPUT_WRITE_FILE=True
# Defaults to <project>/output; docker-compose sets /app/output (./output on the host).
#OUTPUT_DIR=output
OUTPUT_FILE_SUFFIX=_analysis.json
OUTPUT_JSON_INDENT=2
# Also store each AI service's COMPLETE response body under `raw` in that file,
# so it is the full record of the run and not just the fields the pipeline
# reads. The OCR frame array follows OCR_KEEP_FRAMES.
OUTPUT_INCLUDE_RAW=True
# Append the message id to the file name, so re-running a video keeps both.
OUTPUT_UNIQUE_NAMES=False

# ---- PostgreSQL — the client app's read side ----
# W7 writes every finished record here as well as to output/, and the
# /client/... endpoints (src/client) search, chart and export what accumulates.
# The pipeline does not depend on it: with DB_ENABLED=False, or with the server
# down, the seven workers run exactly as before and the records still land in
# output/ — only the browsable side is missing.
DB_ENABLED=True
# Host-side URL, used when the app runs outside Docker. Must match
# PORT_POSTGRES. Inside compose this is overridden to the `postgres` service.
DATABASE_URL=postgresql+psycopg2://video:video@localhost:5434/video_analysis
POSTGRES_USER=video
POSTGRES_PASSWORD=video
POSTGRES_DB=video_analysis
# The tables are created at boot when they are missing; one process owns the
# schema of a PoC, and a migration tool would be a second source of truth.
DB_CREATE_ALL=True
# Log every statement. Very loud — for working out why a filter matched.
DB_ECHO=False
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ---- pgAdmin ----
# A SQL window onto the above, with the server pre-registered from
# maps/pgadmin-servers.json. Sign in with these; the database password is
# POSTGRES_PASSWORD, typed once on first connect.
PGADMIN_EMAIL=admin@local
PGADMIN_PASSWORD=admin

# ---- HTTP API ----
API_HOST=0.0.0.0
API_PORT=5000

# ---- Logging ----
# DEBUG adds one REQUEST and one RESPONSE line per AI call, each with the full
# body (see AI_LOG_DEBUG_BODY_CHARS above), plus one line per HTTP attempt.
LOGGING_LEVEL=DEBUG
